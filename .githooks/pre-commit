#!/bin/sh
# GitHub's ruleset refuses the push anyway; this just saves moving the commit afterwards.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "master" ] && [ -z "$NERD_ALLOW_MASTER" ]; then
    echo "nerd: no commits on master, use a branch and a pull request (NERD_ALLOW_MASTER=1 overrides, once)" >&2
    exit 1
fi
